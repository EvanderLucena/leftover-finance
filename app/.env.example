# Domínio público (deixe localhost para teste local sem HTTPS)
DOMAIN=financas.exemplo.com

# Login básico (senha em hash bcrypt — gere com: docker run --rm caddy:2 caddy hash-password)
AUTH_USER=admin
AUTH_PASS_HASH=$2a$14$exemplo...hash.bcrypt.aqui

# IA (Ollama Cloud ou qualquer API compatível com /v1/chat/completions)
IA_URL=https://ollama.exemplo.com
IA_KEY=sua-chave-aqui
IA_MODEL=deepseek-v4-flash

# AUVP (MCP server de agregação bancária) — opcional
AUVP_URL=
AUVP_KEY=
AUVP_ATIVO=0
