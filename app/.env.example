# Copie para .env (cp .env.example .env) e ajuste. Tudo aqui é opcional.
# O .env é lido pelo `npm start` e pelo `docker compose`; ele nunca vai para o git.

# ------------------------------------------------------------------------------
# Execução local (npm start)
# ------------------------------------------------------------------------------
# Porta do servidor (padrão 4321)
# PORT=4321
# Onde fica o banco SQLite (padrão app/financas.db)
# FINANCA_DB=./financas.db

# ------------------------------------------------------------------------------
# AUVP (Open Finance) — prefira configurar pela tela Configurar.
# Se preencher aqui, o ambiente tem prioridade sobre o que foi salvo na tela
# (com AUVP_ATIVO definido, o checkbox "Usar AUVP como fonte" deixa de valer).
# ------------------------------------------------------------------------------
# AUVP_URL=https://financas-api.auvp.com.br/mcp
# AUVP_KEY=auvp_...
# AUVP_ATIVO=1

# ------------------------------------------------------------------------------
# Docker com HTTPS (docker-compose.yml: app + Caddy)
# ------------------------------------------------------------------------------
# Domínio público apontando para o servidor (use localhost para testar na máquina)
DOMAIN=localhost

# Login da tela de senha do Caddy. Gere o hash com:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'sua-senha'
# Mantenha as ASPAS SIMPLES: sem elas o docker compose tenta expandir os "$" do hash.
AUTH_USER=admin
AUTH_PASS_HASH='$2a$14$troque.por.um.hash.gerado.com.o.comando.acima'
