# Copie para .env (cp .env.example .env) e ajuste. Tudo aqui é opcional.
# O .env é lido pelo `npm start` e pelo `docker compose`; ele nunca vai para o git.

# ------------------------------------------------------------------------------
# Execução local (npm start)
# ------------------------------------------------------------------------------
# Porta do servidor (padrão 4321)
# PORT=4321
# Onde fica o banco SQLite (padrão app/financas.db)
# FINANCA_DB=./financas.db

# ------------------------------------------------------------------------------
# Docker (docker-compose.yml)
# ------------------------------------------------------------------------------
# Porta no computador. Para abrir só nesta máquina, use o docker-compose.local.yml
PORTA=4321
# Endereço que o app mostra para abrir no celular (o container não sabe o IP da máquina)
# FINANCA_ENDERECO=http://192.168.0.10:4321

# ------------------------------------------------------------------------------
# AUVP (Open Finance): prefira colar a chave pela tela (assistente ou Configurar).
# Se preencher aqui, o ambiente tem prioridade sobre o que foi salvo na tela
# (com AUVP_ATIVO definido, o checkbox "Usar AUVP como fonte" deixa de valer).
# ------------------------------------------------------------------------------
# AUVP_KEY=auvp_...
# AUVP_URL=https://financas-api.auvp.com.br/mcp
# AUVP_ATIVO=1
