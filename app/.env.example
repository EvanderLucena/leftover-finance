# Copie para .env (opcional: tudo aqui tem valor padrão)

# Porta no computador. Para abrir só nesta máquina, troque a linha "ports" do docker-compose.yml
PORTA=4321

# Endereço que o app mostra para abrir no celular (o container não sabe o IP da máquina)
# FINANCA_ENDERECO=http://192.168.0.10:4321

# Chave do MCP da AUVP. Opcional: dá para colar pela tela na primeira vez
# AUVP_KEY=
